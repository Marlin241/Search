# Copier vers deploy/monitoring/monitoring.env (gitignoré) sur le serveur.
# Chargé via: docker compose -f docker-compose.monitoring.yml --env-file deploy/monitoring/monitoring.env ...

GT_PG_PASSWORD=REMPLIR
# python -c "import secrets;print(secrets.token_urlsafe(50))"
GT_SECRET_KEY=REMPLIR
GT_FROM_EMAIL=monitoring@yokkutelabs.com
# Resend en SMTP : smtp://resend:<RESEND_API_KEY>@smtp.resend.com:587
# ou consolemail:// pour désactiver l'envoi.
GT_EMAIL_URL=consolemail://
GT_DOMAIN=http://localhost:3001
