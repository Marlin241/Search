# Copier vers deploy/backup/backup.env (gitignoré) sur le serveur.
# Clé publique age (générée hors serveur avec `age-keygen` ; ne mettre ici
# QUE la clé publique `age1...`, jamais la privée).
AGE_RECIPIENT=age1REMPLIR
# Nom du bucket Cloudflare R2.
R2_BUCKET=yokkute-beta-backups
# Chemin absolu du fichier rclone.conf sur le serveur.
RCLONE_CONFIG=/opt/search/deploy/backup/rclone.conf
# Identifiants MinIO de prod (repris dans docker-compose.prod.yml).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
