# Copier vers /opt/search/.env sur le serveur (gitignoré).
# Lu par `docker compose -f docker-compose.prod.yml` pour l'interpolation des
# variables (PAS le même fichier que backend/.env, qui est injecté dans le
# conteneur backend). docker compose charge automatiquement ce .env depuis
# le répertoire du projet.

# Mot de passe Postgres de prod (obligatoire — le compose échoue sans).
POSTGRES_PASSWORD=

# Identifiants MinIO de prod (obligatoires).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# DSN GlitchTip du frontend (Beta 5 ; laisser vide tant que non configuré).
NEXT_PUBLIC_GLITCHTIP_DSN=
